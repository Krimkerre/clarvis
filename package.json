{
  "name": "clarvis",
  "displayName": "Clarvis",
  "description": "Clippy's presence. Jarvis's competence. A butler's disdain.",
  "version": "0.0.1",
  "publisher": "Krimkerre",
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "clarvis", "title": "Clarvis", "icon": "media/bowtie.svg" }
      ]
    },
    "views": {
      "clarvis": [
        { "id": "clarvis.butler", "name": "Clarvis", "type": "webview" }
      ]
    },
    "commands": [
      { "command": "clarvis.debug.setState", "title": "Clarvis: Set Avatar State (Debug)" }
    ]
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "vsce package",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.93.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}
